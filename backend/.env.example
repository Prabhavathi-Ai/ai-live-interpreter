# Set these values in the Render service environment.
APP_ENV=production
# Comma-separated exact HTTPS origins; include the deployed Vercel URL.
CORS_ORIGINS=https://your-project.vercel.app
ENABLE_API_DOCS=false
MAX_AUDIO_BYTES=26214400
AI_MODEL_DIR=/tmp/ai-live-interpreter-models
UPLOAD_DIR=/tmp/ai-live-interpreter-uploads
KEEP_LATEST_RECORDING=false
